rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esPropietari() {
      return request.auth != null
        && resource.data.propietari == request.auth.uid;
    }

    match /membres/{id} {
      allow read, delete: if esPropietari();
      allow create: if request.auth != null
        && request.resource.data.propietari == request.auth.uid;
      allow update: if esPropietari()
        && request.resource.data.propietari == resource.data.propietari;
    }

    match /metges/{id} {
      allow read, delete: if esPropietari();
      allow create: if request.auth != null
        && request.resource.data.propietari == request.auth.uid;
      allow update: if esPropietari()
        && request.resource.data.propietari == resource.data.propietari;
    }

    match /cites/{id} {
      allow read, delete: if esPropietari();
      allow create: if request.auth != null
        && request.resource.data.propietari == request.auth.uid;
      allow update: if esPropietari()
        && request.resource.data.propietari == resource.data.propietari;
    }

    match /configuracio/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.propietari == userId;
    }

    match /proves/{id} {
      allow read, delete: if esPropietari();
      allow create: if request.auth != null
        && request.resource.data.propietari == request.auth.uid;
      allow update: if esPropietari()
        && request.resource.data.propietari == resource.data.propietari;
    }
  }
}
