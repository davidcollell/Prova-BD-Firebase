rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOMÉS PER A PROVES: qualsevol visitant pot llegir, crear, editar i eliminar
    // documents de /proves fins a la data indicada.
    // Canvia la data si necessites allargar les proves.
    match /proves/{documentId} {
      allow read, create, update, delete: if request.time < timestamp.date(2027, 1, 1);
    }

    // La resta de col·leccions queden bloquejades.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
